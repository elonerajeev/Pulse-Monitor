# Server Configuration
PORT=5000
NODE_ENV=development
LOG_LEVEL=debug
APP_VERSION=1.0.0

# Database Configuration
MONGO_URI=mongodb://localhost:27017/pulse-monitor
DB_MAX_POOL_SIZE=10
DB_MIN_POOL_SIZE=5

# Redis Configuration (New!)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379
# Or use full URL:
# REDIS_URL=redis://user:password@redis-server.com:6379/0

# JWT Configuration
ACCESS_TOKEN_SECRET=your_super_secret_access_token_key_change_this_in_production_min_32_chars
REFRESH_TOKEN_SECRET=your_super_secret_refresh_token_key_change_this_in_production_min_32_chars
ACCESS_TOKEN_EXPIRY=5h
REFRESH_TOKEN_EXPIRY=2d

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,https://pulsemonitorlog.netlify.app

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=noreply@pulsemonitor.com
FROM_NAME=Pulse Monitor

# Stripe Configuration
STRIPE_PUBLIC_KEY=pk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_PRO_PLAN_ID=price_xxxxx
STRIPE_ENTERPRISE_PLAN_ID=price_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Feature Flags
ENABLE_2FA=true
ENABLE_SYNTHETIC_MONITORING=false
ENABLE_MULTI_REGION=false
ENABLE_ML_PREDICTIONS=false

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_MS=900000

# Session Configuration
SESSION_TTL_SECONDS=604800
SESSION_ABSOLUTE_TIMEOUT_SECONDS=2592000

# Security
CSRF_COOKIE_NAME=XSRF-TOKEN
BCRYPT_SALT_ROUNDS=10
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL_CHARS=true

# Monitoring
MONITORING_CHECK_INTERVAL_SECONDS=300
MONITORING_SERVICE_REGIONS=us-east-1,eu-west-1,ap-southeast-1

# AWS Configuration (Optional - for multi-region)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Datadog/Monitoring Integration (Optional)
DATADOG_API_KEY=
NEW_RELIC_API_KEY=

# Feature Limits
FREE_TIER_SERVICE_LIMIT=5
PRO_TIER_SERVICE_LIMIT=50
ENTERPRISE_TIER_SERVICE_LIMIT=unlimited

# Logging
LOG_TO_FILE=true
LOG_FILE_PATH=./logs
LOG_RETENTION_DAYS=30
